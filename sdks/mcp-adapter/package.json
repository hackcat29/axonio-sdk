{
  "name": "@axonio/mcp-adapter",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "axonio-mcp": "./dist/index.js",
    "clawdb-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8",
    "@axonio/sdk": "0.2.0"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server for Axonio: persistent agent memory over stdio (Claude Desktop, Cursor, any MCP client).",
  "homepage": "https://axonio.xyz",
  "keywords": [
    "mcp",
    "axonio",
    "agents",
    "memory",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hackcat29/axonio-sdk",
    "directory": "sdks/mcp-adapter"
  }
