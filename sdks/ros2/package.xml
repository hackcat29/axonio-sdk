<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>axonio_ros2</name>
  <version>0.5.0</version>
  <description>ROS2 SDK for Axonio: persistent, fleet-wide spatial memory for robots</description>
  <maintainer email="team@axonio.xyz">Axonio</maintainer>
  <license>MIT</license>

  <url type="website">https://axonio.xyz</url>
  <url type="repository">https://github.com/hackcat29/axonio-sdk</url>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- The Axonio Python SDK has no rosdep key: pip install axonio -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
